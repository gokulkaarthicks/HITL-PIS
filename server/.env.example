# Copy to server/.env and fill in. Never commit the real .env.

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Service-role key (Project Settings -> API -> service_role).
# Server-side only. It bypasses RLS, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter -----------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# --- Determinism / tuning -------------------------------------------------
# Temperature 0 plus a fixed seed keeps evaluation reruns comparable, so an
# accuracy delta reflects the prompt change rather than sampling noise.
LLM_TEMPERATURE=0
LLM_SEED=7
LLM_TIMEOUT_SECONDS=60
# Parallel LLM calls per evaluation arm. Raise cautiously: too high and the
# provider starts rate limiting, which scores as incorrect.
EVAL_CONCURRENCY=4
# Maximum worked examples embedded into an improved prompt.
MAX_FEW_SHOT_EXAMPLES=6

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:5173
